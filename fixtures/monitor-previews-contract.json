{
  "contract": "monitor-previews",
  "version": 1,
  "capability": "monitor-previews-v1",
  "limits": {
    "maxJpegBytes": 98304,
    "maxMessageJsonBytes": 140000,
    "maxDimension": 960,
    "minIntervalMsPerMonitor": 1000
  },
  "messages": [
    {
      "name": "monitor-preview",
      "direction": "host-to-client",
      "json": {
        "type": "monitor-preview",
        "v": 1,
        "monitor": "\\\\.\\DISPLAY2",
        "seq": 7,
        "w": 16,
        "h": 9,
        "jpeg": ""
      }
    }
  ],
  "accept": [
    {
      "name": "valid",
      "json": {
        "type": "monitor-preview",
        "v": 1,
        "monitor": "\\\\.\\DISPLAY2",
        "seq": 7,
        "w": 16,
        "h": 9,
        "jpeg": ""
      },
      "effect": "hold as the latest picture of the monitor selector"
    },
    {
      "name": "unknown-extra-field-ignored",
      "json": {
        "type": "monitor-preview",
        "v": 1,
        "monitor": "\\\\.\\DISPLAY3",
        "seq": 1,
        "w": 16,
        "h": 9,
        "jpeg": "",
        "extra": true
      },
      "effect": "hold"
    }
  ],
  "ignore": [
    {
      "name": "unknown-version",
      "json": {
        "type": "monitor-preview",
        "v": 2,
        "monitor": "\\\\.\\DISPLAY2",
        "seq": 8,
        "w": 16,
        "h": 9,
        "jpeg": ""
      }
    },
    {
      "name": "missing-monitor",
      "json": {
        "type": "monitor-preview",
        "v": 1,
        "seq": 8,
        "w": 16,
        "h": 9,
        "jpeg": ""
      }
    },
    {
      "name": "bad-base64",
      "json": {
        "type": "monitor-preview",
        "v": 1,
        "monitor": "\\\\.\\DISPLAY2",
        "seq": 8,
        "w": 16,
        "h": 9,
        "jpeg": "!!!"
      }
    },
    {
      "name": "empty-jpeg",
      "json": {
        "type": "monitor-preview",
        "v": 1,
        "monitor": "\\\\.\\DISPLAY2",
        "seq": 8,
        "w": 16,
        "h": 9,
        "jpeg": ""
      }
    },
    {
      "name": "not-a-jpeg",
      "json": {
        "type": "monitor-preview",
        "v": 1,
        "monitor": "\\\\.\\DISPLAY2",
        "seq": 8,
        "w": 16,
        "h": 9,
        "jpeg": "AAECAwQ="
      }
    },
    {
      "name": "zero-size",
      "json": {
        "type": "monitor-preview",
        "v": 1,
        "monitor": "\\\\.\\DISPLAY2",
        "seq": 8,
        "w": 0,
        "h": 0,
        "jpeg": ""
      }
    },
    {
      "name": "older-seq-after-newer",
      "after": "valid",
      "json": {
        "type": "monitor-preview",
        "v": 1,
        "monitor": "\\\\.\\DISPLAY2",
        "seq": 3,
        "w": 16,
        "h": 9,
        "jpeg": ""
      }
    }
  ],
  "clientBehaviour": [
    "advertise monitor-previews-v1 in the ctl caps; without it the host sends nothing",
    "keep at most one picture per monitor selector, in memory only, and drop all of them when the session ends",
    "when the live monitor becomes X (selected in a monitor-list, by the user or by the host), drop X's held picture once it has been used",
    "when the selected monitor changes to X and a picture of X is held: show it scaled up at once, then fade to live video on the first live frame of the new media generation (about 200 ms); if none is held, behave as before",
    "never block, delay or reorder video, input or any other message because of a picture"
  ]
}
