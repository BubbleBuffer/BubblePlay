  "sockets": {
    "client": "/file-ws?epoch=<mediaEpoch>",
    "host": "/host-file-ws?epoch=<mediaEpoch>",
    "lab": "/lab-file-ws and /lab-host-file-ws, plus run=<uuid>&compat=<STREAM_LAB_COMPATIBILITY.id> as on the lab media sockets",
    "auth": "client: gate cookie (as /ws); host: Authorization: Bearer <host gate token> (as /host-media-ws)",
    "epoch": "the 32-hex mediaEpoch from the signaling hello-ok; the relay pairs one file-client with one file-host per epoch",
    "text": [
      {
        "from": "either",
        "text": "{\"type\":\"hello\",\"role\":\"file-client\"}",
        "note": "first message; role file-host on the host socket"
      },
      {
        "from": "relay",
        "text": "{\"type\":\"hello-ok\"}"
      },
      {
        "from": "relay",
        "text": "{\"type\":\"file-peer\",\"present\":true}",
        "note": "sent after hello-ok (present true or false) and when the other side arrives; send OFFER/REQUEST only while present (a leaving peer closes this socket instead)"
      },
      {
        "from": "either",
        "text": "{\"type\":\"ping\"}",
        "note": "answered by the relay with {\"type\":\"pong\"}, never relayed; send every 15 s while open"
      }
    ],
    "rules": [
      "binary messages are relayed only after hello and only when they pass decodeFilePacket; REQUEST is accepted only from file-client",
      "when one side closes, the relay closes the other (code 1001 'file-peer-left'); an active transfer is cancelled on both ends",
      "the host keeps its file socket open while a viewer epoch is live and reconnects 1 s after a close; clients open on demand and close after idleCloseMs without a transfer",
      "the client picks every transferId, unique per socket: its OFFER for an upload, its REQUEST for a download (the host answers with OFFER using that transferId); one transfer at a time per direction"
    ]
  },
