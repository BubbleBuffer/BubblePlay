{
  "schemaVersion": 1,
  "defaultProfile": "client",
  "fullProfile": "full",
  "profiles": {
    "client": {
      "paths": [
        "worker/**"
      ],
      "commands": [
        {
          "id": "client-checks",
          "argv": [
            "node",
            "tools/check.mjs",
            "client"
          ],
          "timeout_ms": 300000,
          "provides": [
            "tests",
            "syntax"
          ]
        }
      ]
    },
    "host": {
      "paths": [
        "host/**"
      ],
      "commands": [
        {
          "id": "host-checks",
          "argv": [
            "node",
            "tools/check.mjs",
            "host"
          ],
          "timeout_ms": 300000,
          "provides": [
            "tests",
            "build"
          ]
        }
      ]
    },
    "full": {
      "commands": [
        {
          "id": "full-checks",
          "argv": [
            "node",
            "tools/check.mjs",
            "full"
          ],
          "timeout_ms": 300000,
          "provides": [
            "tests",
            "syntax",
            "build"
          ]
        }
      ]
    }
  }
}
