    "lab:compare": "node tools/lab/stream-lab.mjs compare",
    "lab:cleanup": "node tools/lab/stream-lab.mjs cleanup",
    "lab:diagnostics": "powershell -NoProfile -ExecutionPolicy Bypass -File ../host/scripts/collect-diagnostics.ps1",
