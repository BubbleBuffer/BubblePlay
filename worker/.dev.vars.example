# Copy to .dev.vars for `wrangler dev`, then replace every value.
# The relay answers 500 until TOKEN, HOST_GATE_TOKEN and GATE_ADMIN_TOKEN are
# at least 32 characters and APP_PASSWORD at least 12. Generate tokens with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN = "change-me"
HOST_GATE_TOKEN = "change-me-host-endpoint"
GATE_ADMIN_TOKEN = "change-me-approval-admin"
APP_PASSWORD = "change-me"
NTFY_TOKEN = "change-me-notification-service"
NTFY_URL = "https://ntfy.example.com"
NTFY_TOPIC = "your-random-topic"
# Unset defaults to ntfy. Use host to approve on a connected Windows PC,
# or ntfy,host to notify both. Host-only does not need the NTFY_* values.
# APPROVAL_METHODS = "ntfy"
